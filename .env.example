# ============================================================================
# LifeOS — environment configuration
# ============================================================================
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# Required for the app to boot:  DATABASE_URL, SESSION_SECRET, ADMIN_EMAIL,
#                                ADMIN_PASSWORD
# Required for AI features:      LLAMA_CPP_BASE_URL, LLAMA_CPP_MODEL,
#                                ASR_HTTP_URL, ASR_HTTP_TOKEN
# Optional:                      everything else
# ============================================================================


# --- Database --------------------------------------------------------------
# Postgres 16 connection string. The bundled docker-compose.yml spins up a
# local instance at the URL below.
DATABASE_URL=postgres://lifetracker:lifetracker@localhost:5432/lifetracker


# --- Auth ------------------------------------------------------------------
# 64-byte random base64 string used by iron-session to seal the cookie.
# Generate one with:  openssl rand -base64 64
SESSION_SECRET=

# Bootstraps the single admin account on first boot.
ADMIN_EMAIL=

# First-boot password ONLY. Change it from /profile after logging in.
ADMIN_PASSWORD=

# Set false for the plain-HTTP LAN deployment; set true when HTTPS terminates
# in front of LifeOS.
SESSION_COOKIE_SECURE=false

# Keep this unchanged after first install so moving the checkout does not
# create a second empty database/uploads volume.
LIFEOS_VOLUME_PREFIX=lifeos


# --- Local AI --------------------------------------------------------------
# OpenAI-compatible llama.cpp server. The model id must exactly match /v1/models.
# Docker reaches host services through host.docker.internal on Linux Compose.
LLAMA_CPP_BASE_URL=http://host.docker.internal:8081/v1
LLAMA_CPP_MODEL=

# Token-protected HTTP bridge to the existing Wyoming-compatible STT service.
ASR_HTTP_URL=http://host.docker.internal:10202
# Required. Use the same token configured for the ASR HTTP bridge.
ASR_HTTP_TOKEN=

# Informational provider URL for future spoken-output clients. Current LifeOS
# routes do not call TTS.
TTS_BASE_URL=http://host.docker.internal:10201


# --- Whoop OAuth (optional) ------------------------------------------------
# Register an app at https://developer.whoop.com to sync recovery, sleep,
# strain, workouts, and body measurements. Leave blank to disable.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# Optional — Whoop signs webhooks with the OAuth client_secret by default.
# Only set this if you've configured a separate webhook secret in the portal.
WHOOP_WEBHOOK_SECRET=


# --- App -------------------------------------------------------------------
# Public origin (used in OAuth callbacks and absolute links) for deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 to enable in-process cron jobs (Whoop daily safety-net sync).
# Leave 0 if you run sync from an external scheduler instead.
ENABLE_CRON=0

# IANA timezone. Affects daily rollovers (e.g. "kcal today").
TZ=UTC

NODE_ENV=development


# --- Uploads ---------------------------------------------------------------
# Local filesystem path for uploaded photos.
# In Docker this is overridden to /data/uploads (mounted as a volume).
UPLOADS_DIR=./uploads
